<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "classpath://mybatis-3-mapper.dtd">

<mapper namespace="com.jerry.salesmanagement.mapper.CustomerTypeMapper">
    <select id="selectById" parameterType="long" resultType="com.jerry.salesmanagement.pojo.CustomerType">
        SELECT
            id,
            type_code AS typeCode,
            type_name AS typeName
        FROM customer_type
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultType="com.jerry.salesmanagement.pojo.CustomerType">
        SELECT
            id,
            type_code AS typeCode,
            type_name AS typeName
        FROM customer_type
        ORDER BY id
    </select>
</mapper>
