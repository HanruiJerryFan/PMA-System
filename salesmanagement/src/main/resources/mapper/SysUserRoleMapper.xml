<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "classpath:dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jerry.salesmanagement.mapper.SysUserRoleMapper">
    <select id="selectByUserId" parameterType="long" resultType="com.jerry.salesmanagement.pojo.SysUserRole">
        SELECT user_id AS userId, role_id AS roleId
        FROM sys_user_role
        WHERE user_id = #{userId}
    </select>

    <select id="selectByRoleId" parameterType="long" resultType="com.jerry.salesmanagement.pojo.SysUserRole">
        SELECT user_id AS userId, role_id AS roleId
        FROM sys_user_role
        WHERE role_id = #{roleId}
    </select>

    <insert id="insert" parameterType="com.jerry.salesmanagement.pojo.SysUserRole">
        INSERT INTO sys_user_role (user_id, role_id)
        VALUES (#{userId}, #{roleId})
    </insert>

    <delete id="deleteByUserIdAndRoleId">
        DELETE FROM sys_user_role
        WHERE user_id = #{userId}
          AND role_id = #{roleId}
    </delete>
</mapper>
