<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jerry.salesmanagement.mapper.SysRolePermissionMapper">
    <select id="selectByRoleId" parameterType="long" resultType="com.jerry.salesmanagement.pojo.SysRolePermission">
        SELECT role_id AS roleId, permission_id AS permissionId
        FROM sys_role_permission
        WHERE role_id = #{roleId}
    </select>

    <insert id="insert" parameterType="com.jerry.salesmanagement.pojo.SysRolePermission">
        INSERT INTO sys_role_permission (role_id, permission_id)
        VALUES (#{roleId}, #{permissionId})
    </insert>

    <delete id="deleteByRoleIdAndPermissionId">
        DELETE FROM sys_role_permission
        WHERE role_id = #{roleId}
          AND permission_id = #{permissionId}
    </delete>
</mapper>
